# Copy to the root .env; generate random secrets, never commit real values.
# Use a URL-safe random hex password so it can be embedded in CW_DATABASE_URL.
CW_POSTGRES_PASSWORD=
CW_SECRET_KEY=
CW_PUBLIC_ORIGIN=https://courses.example.org
CW_TLS_DIRECTORY=/absolute/path/to/certificates
CW_ALLOWED_GIT_HOSTS=github.com,farfarfun-cn-hangzhou.devops.aliyuncs.com

# Optional, worker-only read credentials for credential_ref=codeup-reader:
# CW_GIT_USERNAME_CODEUP_READER=your-readonly-account
# CW_GIT_PASSWORD_CODEUP_READER=your-readonly-token
